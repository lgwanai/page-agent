{
  "name": "page-agent",
  "version": "0.10.66",
  "private": true,
  "description": "Turn legacy web pages into reusable, model-callable actions and scripts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-content.mjs",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "mcp": "npm --prefix mcp-server run start",
    "mcp:config": "node scripts/mcp-config.mjs",
    "package:windows": "node scripts/build-windows.mjs",
    "package:mac": "node scripts/build-macos.mjs",
    "mcp:build": "npm --prefix mcp-server run build",
    "test:e2e": "playwright test",
    "release:extension": "npm run build && node scripts/package-extension.mjs",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "docs:serve": "node scripts/docs/serve.mjs"
  },
  "dependencies": {
    "@flowgram.ai/free-layout-editor": "^1.0.13",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@playwright/test": "^1.64.1",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "archiver": "^8.0.0",
    "busboy": "^1.6.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "jsdom": "^26.1.0",
    "marked": "17.0.0",
    "typescript": "^5.4.5",
    "unzipper": "^0.12.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
