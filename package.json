{
  "name": "page-agent",
  "version": "0.7.0",
  "private": true,
  "description": "Turn legacy web pages into reusable, model-callable actions and scripts.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "mcp": "npm --prefix mcp-server run start",
    "mcp:build": "npm --prefix mcp-server run build"
  },
  "dependencies": {
    "@flowgram.ai/free-layout-editor": "^1.0.13",
    "reflect-metadata": "^0.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
